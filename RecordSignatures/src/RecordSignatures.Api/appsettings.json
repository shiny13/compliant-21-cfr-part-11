{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SignaturesDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": true
  },
  "AuthenticationCore": {
    "Issuer": "https://auth.local",
    "Audience": "authentication-core-api",
    "ClockSkew": "00:00:15",
    "JwksUrl": "http://localhost:5194/.well-known/jwks.json",
    "JwksRefreshInterval": "00:05:00",
    "Revocation": {
      "FeedUrl": "http://localhost:5194/auth/revocations",
      "FeedServiceKey": "",
      "PollInterval": "00:00:15"
    }
  },
  "Signatures": {
    "AuthServiceBaseUrl": "http://localhost:5194",
    "AuditTrailBaseUrl": "http://localhost:5196",
    "OrganizationName": "The organization",
    "MaxFailedAttempts": 3,
    "FailureWindow": "00:15:00",
    "LockoutDuration": "00:15:00",
    "ReviewIntervalMonths": 12,
    "MaxCommentLength": 500,
    "HttpTimeout": "00:00:15",
    "AlertWebhookUrl": "",
    "ActiveSealKeyId": "",
    "SealKeys": {}
  }
}
