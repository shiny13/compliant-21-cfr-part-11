<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Generated EF migrations and the design-time factory are excluded; everything else is measured. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Include>[RecordSignatures.*]*</Include>
          <Exclude>[RecordSignatures.*.Tests]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
