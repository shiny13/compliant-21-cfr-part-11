{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AuditDb": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": true
  },
  "AuthenticationCore": {
    "Issuer": "https://auth.local",
    "Audience": "authentication-core-api",
    "ClockSkew": "00:00:15",
    "JwksUrl": "http://localhost:5194/.well-known/jwks.json",
    "JwksRefreshInterval": "00:05:00",
    "Revocation": {
      "FeedUrl": "http://localhost:5194/auth/revocations",
      "FeedServiceKey": "",
      "PollInterval": "00:00:15"
    }
  },
  "Retention": {
    "DefaultYears": 7,
    "ByRecordType": {
      "ClinicalTrial": 15,
      "BatchRecord": 10
    }
  }
}
