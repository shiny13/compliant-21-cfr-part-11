{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthenticationCore": {
    "Issuer": "https://auth.local",
    "Audience": "authentication-core-api",
    "AccessTokenTtl": "00:05:00",
    "ClockSkew": "00:00:15",
    "JwksRefreshInterval": "00:05:00",
    "Revocation": {
      "PollInterval": "00:00:15"
    }
  }
}
